# Copy to .env and fill in EVERY value. Never commit the real file.

# --- database (the compose file builds DATABASE_URL from these) ---
POSTGRES_USER=wfm
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=wfm

# --- Django ---
# A long random string; changing it signs everybody out.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
# The address people type, without the scheme.
DJANGO_ALLOWED_HOSTS=wfm.example.co.za
# With the scheme: needed for sign-in and CSRF behind your TLS terminator.
DJANGO_CSRF_TRUSTED_ORIGINS=https://wfm.example.co.za

# --- what is switched on (all, or a comma-separated list of features) ---
WFM_FEATURES=all

# --- the ACD export's time zone, and the upload limit ---
WFM_CDR_SOURCE_TIMEZONE=Africa/Johannesburg
WFM_CDR_MAX_UPLOAD_MB=25

# --- outgoing email for scheduled reports ---
WFM_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
WFM_EMAIL_HOST=smtp.example.co.za
WFM_EMAIL_PORT=587
WFM_EMAIL_TLS=1
WFM_EMAIL_USER=
WFM_EMAIL_PASSWORD=
WFM_EMAIL_FROM=wfm@example.co.za

# --- sign-in methods: see docs/adr/0001 and tech spec section 10. Never put a secret in the
# provider config; name an environment variable and set that variable here.
# WFM_IDENTITY_PROVIDERS=
# WFM_IDENTITY_CONFIG=/run/secrets/identity.json

# --- the host port for the web container, and where backups are written ---
WEB_PORT=8080
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

LOG_LEVEL=INFO
