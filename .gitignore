# Source material from Gijima/VMK: contains personal data (caller phone numbers,
# staff names) and commercial-in-confidence documents. Never commit (POPIA).
/Files/

# Real data must never land in the repo; tests use anonymised fixtures only.
*.xlsx
*.xls
!**/fixtures/**/*.xlsx

# Environment and secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
coverage/

# Playwright output (screenshots may show demo data; never commit)
e2e/playwright-report/
e2e/test-results/
e2e/screenshots/

# .NET (Aspire AppHost)
bin/
obj/
*.user

# Logs
*.log

# Editors / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Celery beat scheduler state
celerybeat-schedule*

# Playwright MCP session output (snapshots, console logs)
/.playwright-mcp/
