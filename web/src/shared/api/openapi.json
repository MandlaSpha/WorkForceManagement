{
  "components": {
    "schemas": {
      "LoginIn": {
        "properties": {
          "password": {
            "title": "Password",
            "type": "string"
          },
          "provider": {
            "default": "local",
            "title": "Provider",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "displayName": {
            "title": "Displayname",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "displayName",
          "role"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "ProviderOut": {
        "properties": {
          "flow": {
            "title": "Flow",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "restricted": {
            "default": false,
            "title": "Restricted",
            "type": "boolean"
          },
          "startUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Starturl"
          }
        },
        "required": [
          "id",
          "kind",
          "label",
          "flow"
        ],
        "title": "ProviderOut",
        "type": "object"
      },
      "WorkerPingOut": {
        "properties": {
          "apiTraceId": {
            "title": "Apitraceid",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "workerTraceId": {
            "title": "Workertraceid",
            "type": "string"
          }
        },
        "required": [
          "ok",
          "apiTraceId",
          "workerTraceId"
        ],
        "title": "WorkerPingOut",
        "type": "object"
      }
    },
    "securitySchemes": {
      "RoleSessionAuth": {
        "in": "cookie",
        "name": "sessionid",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "",
    "title": "Gijima WFM API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/csrf": {
      "get": {
        "operationId": "wfm_accounts_api_csrf",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "summary": "Set the CSRF cookie and return the token",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "wfm_identity_api_login",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Sign in with a username and password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "wfm_accounts_api_logout",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "security": [
          {
            "RoleSessionAuth": []
          }
        ],
        "summary": "Sign out",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "wfm_accounts_api_me",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "RoleSessionAuth": []
          }
        ],
        "summary": "The signed-in user",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/providers": {
      "get": {
        "operationId": "wfm_identity_api_list_providers",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProviderOut"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Sign-in methods on offer",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/sso/{provider_id}/callback": {
      "get": {
        "operationId": "wfm_identity_api_sso_callback",
        "parameters": [
          {
            "in": "path",
            "name": "provider_id",
            "required": true,
            "schema": {
              "title": "Provider Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "summary": "Finish SSO",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/sso/{provider_id}/start": {
      "get": {
        "operationId": "wfm_identity_api_sso_start",
        "parameters": [
          {
            "in": "path",
            "name": "provider_id",
            "required": true,
            "schema": {
              "title": "Provider Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "next",
            "required": false,
            "schema": {
              "default": "/",
              "title": "Next",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "summary": "Begin SSO",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/system/ping-worker": {
      "post": {
        "description": "Is the worker alive, and does trace context survive the queue? Both trace ids should match\nwhen tracing is on.",
        "operationId": "wfm_core_api_ping_worker",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkerPingOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "RoleSessionAuth": []
          }
        ],
        "summary": "Round trip through the background worker",
        "tags": [
          "system"
        ]
      }
    }
  },
  "servers": []
}
